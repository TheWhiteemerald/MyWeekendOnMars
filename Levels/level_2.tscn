[node name="Signs" type="Node2D" parent="." unique_id=1068194397]

[node name="Sign" parent="Signs" unique_id=1783817702 instance=ExtResource("9_2u4r5")]
position = Vector2(3032, -924)
dialogue_pages = Array[String](["
  I got this feeling about this place...", "
  There's tougher bots here so be careful!"])

[node name="Sign2" parent="Signs" unique_id=117233694 instance=ExtResource("9_2u4r5")]
position = Vector2(4112, -1136)
dialogue_pages = Array[String](["
  Yo! You feelin parched?

  I see you diggin but I dunno if youse are drinkin.

  Long as you move and drill, you drain energy.", "
  Those floating green cans? Yeah those are Recharge Batteries!

  And you need em, trust you me!", "
  It refills that second bar on your top left.

  If they goes all the way down, youse is DEAD!

  So drink em when you can, toots."])

[node name="Sign3" parent="Signs" unique_id=553393260 instance=ExtResource("9_2u4r5")]
position = Vector2(2864, -1392)
dialogue_pages = Array[String](["
  Oye mate! You done seen them crystals?

  Yeaaaah. Full of energy they are!", "
  Break em down and store that energy, it'll keep ya movin!

  Your mission objective demands 12 of em!", "
  Something tells me that you won't be able

  to leave until you broken 12 crystals...

  So you better get moving!"])

[node name="Sign4" parent="Signs" unique_id=143776897 instance=ExtResource("9_2u4r5")]
position = Vector2(2864, -1480)
dialogue_pages = Array[String](["
  Well I'll be a monkey's uncle...

  That there is a Spike Bot. Nasty critters.", "
  Betcha noticed they hurt ya when you touch um.

  Eyup... They seem to got it out for ye feller.", "
  Course if I couldn't do nothing but sit there all day...

  I'd be angry and ready to destroy you, too.

  Wait a min..."])

[node name="Sign5" parent="Signs" unique_id=295532109 instance=ExtResource("9_2u4r5")]
position = Vector2(3080, -1384)
dialogue_pages = Array[String](["
  Zoinks! How'd you get up here??", "
  Like, must be nice to watch your energy go up.

  Cuz you're like, solar powered and stuff.", "
  Not us though. We use diesel!"])

[node name="Sign6" parent="Signs" unique_id=523431175 instance=ExtResource("9_2u4r5")]
position = Vector2(2960, -1488)
dialogue_pages = Array[String](["
  Why didn't they finish this colony anyways?", "
  Maybe they liked it better in their cozy cabin?

  Maybe it was better to stay home than to go outside?

  Maybe that's why we were left here?", "
  Huh??

  You don't remember either??"])

[node name="Sign7" parent="Signs" unique_id=1683802375 instance=ExtResource("9_2u4r5")]
position = Vector2(631, -764)
dialogue_pages = Array[String](["
  CAUTION!

  Look out for falling gravel!", "
  Oh. You knew that already?"])

[node name="Sign8" parent="Signs" unique_id=910926713 instance=ExtResource("9_2u4r5")]
position = Vector2(1463, -700)
dialogue_pages = Array[String](["
  You ever tried wall jumping?

  Not too hard, I dare say.", "
  Hit the jump button while you're facing a wall!

  I'm a lil jealous of you, not gonna lie."])

[node name="Sign9" parent="Signs" unique_id=1298310535 instance=ExtResource("9_2u4r5")]
position = Vector2(2216, -876)
dialogue_pages = Array[String](["
  Did you get all the crystal ores?", "  Maybe you should collect more than 12?"])

