[node name="Sign" parent="Signs" unique_id=1783817702 instance=ExtResource("9_2u4r5")]
position = Vector2(-1775, -710)
dialogue_pages = Array[String](["
  HEY! I'M WALKIN ERE!

  Well... Not really. I don't have legs...

  But I do got things to say! An' a big mouth!", "
  So youse got caught in the rock slide too, eh?

  But youse got legs, unlike me, and a drill!

  You know you can dig outta here, ya get me?", "
  Hold down X, or whatever button you prefer!

  You can dig through that orange dirt

  but not that tough rock, see?"])

